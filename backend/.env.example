# Backend env template — copy karke .env.local (dev) banao.
# Production (Render) mein ye values Render dashboard -> Environment mein set karo.

# Local server port (Render apna PORT khud inject karta hai, ye wahan ignore ho jaata hai)
PORT=5000

# Frontend origins ki comma-separated allowlist (CORS). Empty = sab allowed (sirf local dev ke liye).
CORS_ORIGINS=http://localhost:5173
